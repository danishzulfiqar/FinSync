# ==========================================================================
# FinSync backend environment. Copy to `.env` and fill in real values.
#   cp backend/.env.example backend/.env
# NEVER commit the real .env file.
# ==========================================================================

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ---- Database ----
# For local (non-Docker) runs against the compose Postgres:
DATABASE_URL=postgresql+psycopg://finsync:finsync@localhost:5432/finsync
# Compose overrides host to `db` automatically for the backend container.
POSTGRES_USER=finsync
POSTGRES_PASSWORD=finsync
POSTGRES_DB=finsync
POSTGRES_PORT=5432
BACKEND_PORT=8000

# ---- CORS ----
# Comma-separated frontend origins allowed to call the API (no trailing slash).
# In production set this to your Vercel URL, e.g. https://finsync.vercel.app
# Local dev origins (http://localhost:5173) are always allowed automatically.
CORS_ORIGINS=

# ---- Auth / JWT ----
# Generate a strong secret, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes (default 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- SMS webhook security (android-sms-gateway HMAC signing key) ----
# Set this to the "Signing Key" shown in the Android app: Settings > Webhooks > Signing Key.
SMS_WEBHOOK_SIGNING_KEY=change-me-to-the-android-app-signing-key
# Reject webhook requests whose X-Timestamp is older/newer than this many seconds.
SMS_WEBHOOK_MAX_SKEW_SECONDS=300
# Optional: restrict which sender numbers are treated as HBL (comma-separated).
# Leave blank to rely on providers.yaml sms_senders instead.
HBL_SMS_SENDERS=

# ---- Gmail API (OAuth 2.0, read-only) ----
# Path to the OAuth client secret downloaded from Google Cloud Console.
GMAIL_CLIENT_SECRET_FILE=secrets/gmail_client_secret.json
# Where the OAuth refresh token is persisted after the first authorization.
GMAIL_TOKEN_FILE=secrets/gmail_token.json
# Minimum scope: read-only mailbox access.
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
# Redirect URI used during the local OAuth flow.
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8765/oauth2callback

# ---- Provider config ----
PROVIDERS_CONFIG_FILE=providers.yaml

# ---- Deduplication tuning ----
DEDUP_TIME_WINDOW_SECONDS=180
DEDUP_PROBABLE_ENABLED=true
