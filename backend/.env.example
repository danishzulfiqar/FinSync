# ==========================================================================
# FinSync backend environment. Copy to `.env` and fill in real values.
#   cp backend/.env.example backend/.env
# NEVER commit the real .env file.
# ==========================================================================

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ---- Database ----
# For local (non-Docker) runs against the compose Postgres:
DATABASE_URL=postgresql+psycopg://finsync:finsync@localhost:5432/finsync
# Compose overrides host to `db` automatically for the backend container.
POSTGRES_USER=finsync
POSTGRES_PASSWORD=finsync
POSTGRES_DB=finsync
POSTGRES_PORT=5432
BACKEND_PORT=8000

# ---- CORS ----
# Comma-separated frontend origins allowed to call the API (no trailing slash).
# In production set this to your Vercel URL, e.g. https://finsync.vercel.app
# Local dev origins (http://localhost:5173) are always allowed automatically.
CORS_ORIGINS=

# ---- Auth / JWT ----
# Generate a strong secret, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes (default 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- SMS webhook security (android-sms-gateway HMAC signing key) ----
# Set this to the "Signing Key" shown in the Android app: Settings > Webhooks > Signing Key.
SMS_WEBHOOK_SIGNING_KEY=change-me-to-the-android-app-signing-key
# Reject webhook requests whose X-Timestamp is older/newer than this many seconds.
SMS_WEBHOOK_MAX_SKEW_SECONDS=300
# Optional: restrict which sender numbers are treated as HBL (comma-separated).
# Leave blank to rely on providers.yaml sms_senders instead.
HBL_SMS_SENDERS=

# ---- SMS gateway (Cloud mode, api.sms-gate.app) ----
# On-demand sync: POST /api/v1/sms/sync asks the phone (via the cloud API) to
# replay its inbox for a date range as batch webhooks to this backend. Only a
# sms:batch:received webhook is registered, so new SMS don't trigger anything.
# Username/password from the app's Home tab > Cloud Server card.
SMS_CLOUD_USERNAME=
SMS_CLOUD_PASSWORD=
# Optional: pin a device id (defaults to the first device on the account).
SMS_CLOUD_DEVICE_ID=
# Public HTTPS base URL of this backend (ngrok locally, Render in prod).
SMS_WEBHOOK_PUBLIC_URL=
SMS_CLOUD_TIMEOUT_SECONDS=20
# Look-back (days) for the first sync when no HBL SMS is on record yet.
SMS_SYNC_DEFAULT_LOOKBACK_DAYS=30

# ---- Gmail API (OAuth 2.0, read-only) ----
# Web OAuth client (preferred in production / on hosts with no secret file):
# create an OAuth client of type "Web application" in Google Cloud Console and
# add the callback below as an authorized redirect URI.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Backend callback Google redirects to after consent. Must EXACTLY match the
# authorized redirect URI configured on the OAuth client.
#   local:  http://localhost:8000/api/v1/sync/gmail/callback
#   prod:   https://<your-backend-host>/api/v1/sync/gmail/callback
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/sync/gmail/callback
# Where the backend sends the browser back to after authorization. Defaults to
# the first CORS origin, else http://localhost:5173.
FRONTEND_URL=
# Local dev alternative: a downloaded client secret file (Desktop or Web app).
GMAIL_CLIENT_SECRET_FILE=secrets/gmail_client_secret.json
# Where the OAuth refresh token is persisted for the local file-based flow.
GMAIL_TOKEN_FILE=secrets/gmail_token.json
# Minimum scope: read-only mailbox access.
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
# Per-user quota budget for syncs (Google limit: 6000 units/user/min; a full
# messages.get costs 60). Raise only if your project has legacy higher quotas.
GMAIL_QUOTA_UNITS_PER_MINUTE=5000
# Messages fetched per batch HTTP request (Google recommends <= 50).
GMAIL_BATCH_SIZE=50

# ---- Provider config ----
PROVIDERS_CONFIG_FILE=providers.yaml

# ---- Deduplication tuning ----
DEDUP_TIME_WINDOW_SECONDS=180
DEDUP_PROBABLE_ENABLED=true
